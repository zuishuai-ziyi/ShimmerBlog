# 统一换行：仓库内一律 LF（Windows 检出亦为 LF，避免整文件假 diff）
* text=auto eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff  binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.mp4 binary

# 明确语言级文本类型（便于 GitHub 语言统计与 diff）
*.ts   text eol=lf
*.vue  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
