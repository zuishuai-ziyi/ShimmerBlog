# 服务
PORT=3010
JWT_SECRET=change-me-to-a-long-random-string
# 前端构建产物目录（可省略：默认取 ../web/dist，存在则后端直接托管 SPA）
WEB_DIST=

# 数据库（MySQL 8.x，本机 Windows 实例）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shimmerblog

# 管理后台密码（首次启动建库时写入哈希）
ADMIN_PASSWORD=shimmer-admin

# GitHub OAuth（后台可覆盖）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP（邮箱验证码用；未配置时验证码打印到服务端日志）
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
